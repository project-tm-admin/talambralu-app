# Copy to .env for local development
# In production these are set as Cloud Run env vars

# Firebase project ID — used by Admin SDK when GOOGLE_APPLICATION_CREDENTIALS is set
FIREBASE_PROJECT_ID=talambralu-matrimony-e15c2

# Port (Cloud Run sets this automatically)
PORT=8080

# Daily free-tier interest limit
DAILY_INTEREST_LIMIT=3

# Discovery feed page size
FEED_PAGE_SIZE=20

# RevenueCat webhook secret
# Set this in RevenueCat dashboard → Project → Integrations → Webhooks → Authorization header
# Must match exactly (no "Bearer " prefix)
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret_here
