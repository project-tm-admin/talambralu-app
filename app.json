{
  "expo": {
    "newArchEnabled": false,
    "name": "Talambralu",
    "slug": "talambralu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.talambralu.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Talambralu needs camera access for video calls and profile photos.",
        "NSMicrophoneUsageDescription": "Talambralu needs microphone access for voice and video calls.",
        "NSPhotoLibraryUsageDescription": "Talambralu needs photo library access to upload profile photos and verification documents.",
        "NSContactsUsageDescription": "Talambralu does not require contacts but this is needed by the Firebase SDK.",
        "NSUserNotificationUsageDescription": "We'll notify you when you receive messages or interest from matches."
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.talambralu.app",
      "versionCode": 8,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8B1F2E",
          "sounds": [
            "./assets/sounds/notification.wav"
          ]
        }
      ],
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3085ec40-e78c-422a-a96d-18b12216a889"
      }
    },
    "owner": "talambralu-app"
  }
}
