generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MatchStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Profile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id")
  fullName         String   @map("full_name")
  dob              DateTime @db.Date
  gender           Gender
  isFaceVerified   Boolean  @default(false) @map("is_face_verified")
  incomeBracket    String?  @map("income_bracket")
  isIncomeVerified Boolean  @default(false) @map("is_income_verified")
  isWorkVerified   Boolean  @default(false) @map("is_work_verified")
  searchVector     Unsupported("tsvector")? @map("search_vector")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Match {
  id         String      @id @default(uuid()) @db.Uuid
  senderId   String      @map("sender_id")
  receiverId String      @map("receiver_id")
  status     MatchStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  messages   Message[]

  @@unique([senderId, receiverId])
  @@map("matches")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @db.Uuid @map("match_id")
  senderId  String   @map("sender_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("messages")
}
