generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MatchStatus {
  PENDING
  ACCEPTED
  DECLINED
  PASSED
}

model Profile {
  id               String                   @id @default(uuid()) @db.Uuid
  userId           String                   @unique @map("user_id")
  fullName         String                   @map("full_name")
  dob              DateTime                 @db.Date
  gender           Gender
  isFaceVerified   Boolean                  @default(false) @map("is_face_verified")
  incomeBracket    String?                  @map("income_bracket")
  isIncomeVerified Boolean                  @default(false) @map("is_income_verified")
  isWorkVerified   Boolean                  @default(false) @map("is_work_verified")
  isAdmin          Boolean                  @default(false) @map("is_admin")
  searchVector     Unsupported("tsvector")? @map("search_vector")
  photos           String[]                 @default([])
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  matchesSent     Match[]           @relation("MatchesSent")
  matchesReceived Match[]           @relation("MatchesReceived")
  subscription    UserSubscription?

  @@map("profiles")
}

model Match {
  id         String      @id @default(uuid()) @db.Uuid
  senderId   String      @map("sender_id")
  receiverId String      @map("receiver_id")
  status     MatchStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  messages   Message[]

  sender   Profile @relation("MatchesSent", fields: [senderId], references: [userId], onDelete: Cascade)
  receiver Profile @relation("MatchesReceived", fields: [receiverId], references: [userId], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("matches")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @map("match_id") @db.Uuid
  senderId  String   @map("sender_id") // Firebase UID — cascades via Match (Profile → Match → Message), no direct FK needed
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("messages")
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

model UserSubscription {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @unique @map("user_id") // Firebase UID
  tier               SubscriptionTier @default(FREE)
  lastEventId        String?          @map("last_event_id") // idempotency key
  lastEventTimestamp DateTime?        @map("last_event_timestamp")
  expiresAt          DateTime?        @map("expires_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_subscriptions")
}
